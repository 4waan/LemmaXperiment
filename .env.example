# Copy to .env (gitignored). Testnet and hackathon use only.

# Alchemy (or any archive provider that returns correct eth_getProof)
RPC_1=https://eth-mainnet.g.alchemy.com/v2/<key>
RPC_421614=https://arb-sepolia.g.alchemy.com/v2/<key>

# Execution and proving host (Oracle Always Free ARM VM; no GPU)
EXEC_HOST="ubuntu@<ip>"
RSP_WORKDIR=/work/apparatus

# Real proofs (three total) are CPU proofs on the execution host.
SP1_PROVER=cpu
# Optional: Succinct Prover Network requester key, only if credits are available
# NETWORK_PRIVATE_KEY=0x...

# Testnet wallets, generated with `cast wallet new`, funded from a faucet
SPONSOR_PRIVATE_KEY=0x...
EVALUATOR_PRIVATE_KEY=0x...
# EVALUATOR key stays on the laptop, never on the execution host
CREATOR_PAYEE_PRIVATE_KEY=0x...
CREATOR_PAYEE_ADDRESS=0x...        # address, not key; derive with `cast wallet address`
WORKER_PRIVATE_KEY=0x...
