#!/bin/sh
# Blocks a commit that stages a credential (secret-scan skill, .claude/skills).
# Installed with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); refusing to commit unscanned changes" >&2
  exit 1
fi
exec gitleaks protect --staged --no-banner --redact
